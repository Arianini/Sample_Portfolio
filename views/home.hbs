<section id="hero">
  <canvas id="bg-canvas"></canvas>

  <div class="hero-grid">
    <div class="hero-content">
      <p class="hero-eyebrow">Fig. 01 &mdash; Statistics Graduate</p>
      <h1>{{name}}</h1>
      <p class="hero-role">{{role}}</p>
      <p class="hero-caption" id="tagline" data-tagline="{{tagline}}"></p>

      <div class="hero-actions">
        <a href="/projects" class="btn">View My Work</a>
        {{#if resumeUrl}}
          <a href="{{resumeUrl}}" class="btn btn-ghost" target="_blank" rel="noopener">
            <i class="fas fa-file-arrow-down"></i> Résumé
          </a>
        {{/if}}
      </div>

      <div class="hero-socials">
        {{#each socials}}
          <a href="{{url}}" target="_blank" rel="noopener">
            <i class="{{icon}}"></i>
          </a>
        {{/each}}
      </div>
    </div>
  </div>

  <div class="hero-axis hero-axis-x" aria-hidden="true"></div>
  <div class="hero-axis hero-axis-y" aria-hidden="true"></div>
</section>
