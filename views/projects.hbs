{{!-- views/projects.hbs --}}
<section id="projects">
  <p class="section-eyebrow">Fig. 02 &mdash; Selected Work</p>
  <h2 class="section-heading">Projects</h2>

  <div class="project-list">
    {{#each projects}}
      <div class="project-card-wrapper">
        <div class="project-card">

          <div class="project-preview">
            {{#if img}}
              <img src="{{img}}" alt="{{title}} preview" loading="lazy" />
            {{else}}
              <div class="data-glyph" aria-hidden="true">
                <svg viewBox="0 0 200 120" preserveAspectRatio="none">
                  <line x1="10" y1="105" x2="190" y2="105" class="glyph-axis" />
                  <line x1="10" y1="10" x2="10" y2="105" class="glyph-axis" />
                  <rect x="28" y="55" width="18" height="50" class="glyph-bar glyph-bar-1" />
                  <rect x="58" y="30" width="18" height="75" class="glyph-bar glyph-bar-2" />
                  <rect x="88" y="65" width="18" height="40" class="glyph-bar glyph-bar-3" />
                  <rect x="118" y="15" width="18" height="90" class="glyph-bar glyph-bar-4" />
                  <rect x="148" y="45" width="18" height="60" class="glyph-bar glyph-bar-5" />
                </svg>
              </div>
            {{/if}}
          </div>

          <div class="project-info">
            {{#if sample}}
              <span class="sample-badge">Sample &mdash; replace with a real project</span>
            {{/if}}

            <h3 class="project-title">{{title}}</h3>

            {{#if tools}}
              <div class="project-tools">
                {{#each tools}}
                  <span class="tool-tag">{{this}}</span>
                {{/each}}
              </div>
            {{/if}}

            <p class="project-desc">{{description}}</p>

            <div class="project-links">
              {{#if github}}
                <a href="{{github}}" target="_blank" rel="noopener" class="btn-secondary">
                  <i class="fab fa-github"></i> View Code
                </a>
              {{/if}}
              {{#if live}}
                <a href="{{live}}" target="_blank" rel="noopener" class="btn-primary">
                  Live Demo <i class="fas fa-arrow-up-right-from-square"></i>
                </a>
              {{/if}}
            </div>
          </div>

        </div>
      </div>
    {{/each}}
  </div>
</section>
