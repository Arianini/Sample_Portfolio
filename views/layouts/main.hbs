<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{name}} — Portfolio</title>
  <meta name="description" content="Portfolio of {{name}}, Statistics graduate." />

  <!-- FontAwesome (served locally at /assets/css/all.min.css) -->
  <link rel="stylesheet" href="/assets/css/all.min.css" />

  <!-- Type system: Space Grotesk (display) / IBM Plex Sans (body) / IBM Plex Mono (data & labels) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
